{
  "expo": {
    "name": "Clínica Saúde",
    "slug": "clinica-saude-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clinicasaude",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A5C8A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clinicasaude.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Usado para lembretes de consultas.",
        "NSRemindersUsageDescription": "Usado para lembretes de consultas."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A5C8A"
      },
      "package": "com.clinicasaude.app",
      "permissions": [
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "USE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A5C8A",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
